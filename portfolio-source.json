{
  "schema": "glaciereq.portfolio-consumer-pointer.v1",
  "consumer": "GlacierEQ/job-application",
  "projection_id": "public_portal",
  "authority": {
    "repository": "GlacierEQ/job-app-helix",
    "branch": "main",
    "manifest_path": "manifests/portfolio_root_truth.json",
    "manifest_url": "https://raw.githubusercontent.com/GlacierEQ/job-app-helix/main/manifests/portfolio_root_truth.json"
  },
  "sync": {
    "script": "scripts/sync-helix-projection.mjs",
    "output": "site-v15/data/helix-root.json",
    "mode": "build_time_pull",
    "fail_closed": true,
    "allow_stale_fallback": false
  },
  "public_boundary": {
    "publish_private_records": false,
    "allowed_repository_visibility": ["public"],
    "allowed_promotion_states": [
      "PROMOTED",
      "REFERENCE_ONLY",
      "BLOCKED",
      "BLOCKED_SECURITY",
      "EXPERIMENT"
    ],
    "excluded_surface_markers": [
      "PRIVATE",
      "SANITIZED_CARD_ONLY",
      "EXCLUDED",
      "QUARANTINED"
    ]
  },
  "invariants": [
    "Helix remains the portfolio authority.",
    "This repository remains a generated public presentation surface.",
    "A successful render is not evidence that the source projection is current.",
    "Factual IDs, evidence states, blockers, test counts, and non-affiliation boundaries are invariant across presentation layers.",
    "No private repository identity or private operational metadata may enter the generated public snapshot."
  ]
}
