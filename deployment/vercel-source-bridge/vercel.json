{
  "version": 2,
  "routes": [
    {
      "src": "/data/recruiter-role-matrix.json",
      "dest": "/api/recruiter-role-matrix"
    },
    {
      "src": "/data/recruiter-gap-analysis.json",
      "dest": "/api/recruiter-gap-analysis"
    },
    {
      "src": "/recruiter-gap-analysis/?",
      "dest": "/api/recruiter-gap-page"
    },
    {
      "src": "/(.*)",
      "dest": "/api/release-router?path=$1"
    }
  ]
}
