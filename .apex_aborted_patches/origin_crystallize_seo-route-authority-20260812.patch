-            {
-                "text": text,
-                "provenance": provenance,
-                "evidence_class": evidence_class,
-                "source_sha256": row.get("source_sha256"),
-            }
-        )
-    return result
-
-
-def _exceptional_prompt(preparation: Mapping[str, object]) -> dict[str, object]:
