-  if (filePath === 'data/estate-intelligence.json') return serveEstateJson(res);
-  if (filePath === 'atlas/index.html' || companyIdForPath(filePath)) {
-    return serveCaptured(req, res, filePath);
-  }
-  return delegateV22(req, res);
-};
