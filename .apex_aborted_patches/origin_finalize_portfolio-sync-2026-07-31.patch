-  const advanced = repositories.some((repo) => repo.level === 'L4' || repo.level === 'L5');
-  if (repositories.length >= 2 || advanced) return 'repository-rich';
-  if (repositories.length === 1) return 'seeded';
-  return 'scaffold';
