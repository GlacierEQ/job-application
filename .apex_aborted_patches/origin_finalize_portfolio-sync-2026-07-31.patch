-function replayHeaders(captured, res) {
-  for (const [name, value] of captured.headers) {
-    if (
-      name === 'content-length' ||
-      name === 'x-glaciereq-source-commit' ||
-      name === 'x-glaciereq-helix-commit' ||
-      name === 'x-glaciereq-estate-helix-commit' ||
