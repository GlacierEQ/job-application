-        return None
-    candidates.sort(
-        key=lambda run: (
-            str(run.get("updated_at") or ""),
-            run.get("head_branch") == default_branch,
-            int(run.get("id") or 0),
-        ),
-        reverse=True,
-    )
-    return candidates[0]
